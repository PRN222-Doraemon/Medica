@using MedicaWeb_MVC.ViewModels.Courses
@model CourseCreateVM

@if (Model.CourseChapters != null)
{
    @for (int i = 0; i < Model.CourseChapters.Count(); i++)
    {
        var chapter = Model.CourseChapters.ToList()[i];
        var collapseId = $"collapse-{chapter.Id}";

        <div class="accordion-item chapter-card mb-3 shadow-sm border bg-light-blue" data-chapter-index="@i">
            <div class="accordion-header p-3">
                <div class="d-flex align-items-center w-100">
                    <!-- Toggle Collapse Button -->
                    <button class="btn btn-link text-primary fw-bold me-2" type="button" data-bs-toggle="collapse"
                        data-bs-target="#@collapseId" aria-expanded="true" aria-controls="@collapseId">
                        <i class="bi bi-chevron-down"></i>
                    </button>

                    <input type="hidden" name="CourseChapters[@i].Id" value="@chapter.Id" />

                    <!-- Chapter Name & Description -->
                    <div class="flex-grow-1">
                        <input type="text" class="form-control chapter-name mb-2" name="CourseChapters[@i].Name"
                            value="@chapter.Name" required placeholder="Enter chapter name">

                        <textarea class="form-control" name="CourseChapters[@i].Description" rows="2"
                            placeholder="Enter chapter description">@chapter.Description</textarea>
                    </div>

                    <!-- Remove Chapter Button -->
                    <button type="button" class="btn btn-outline-danger btn-sm ms-2 me-2" onclick="removeChapter(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>

            <!-- Chapter Content -->
            <div id="@collapseId" class="accordion-collapse collapse">
                <div class="accordion-body bg-light">
                    <div class="resources-container">
                        @* <partial name="PartialViews/_ResourcesListUpsert" model="@chapter" /> *@
                        @if (chapter.Resources != null)
                        {
                            @for (int j = 0; j < chapter.Resources.Count(); j++)
                            {
                                var resource = chapter.Resources.ToList()[j];

                                <input type="hidden" name="CourseChapters[@i].Resources[@j].Id" value="@resource.Id" />
                                <input type="hidden" name="CourseChapters[@i].Resources[@j].FileUrl" value="@resource.FileUrl" />

                                <div class="resource-item mb-3 p-3 bg-white rounded shadow-sm" data-resource-index="@j">
                                    <div class="d-flex flex-column">

                                        <!-- Resource Header -->
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            @if (resource.ResourceType == ResourceType.Slide)
                                            {
                                                <i class="bi bi-file-pdf text-danger"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-play-circle text-primary"></i>
                                            }
                                            <div class="flex-grow-1">
                                                <input type="text" class="form-control" name="CourseChapters[@i].Resources[@j].Title"
                                                    value="@resource.Title" required placeholder="Enter resource title">
                                            </div>

                                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeResource(this)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>

                                        <!-- Resource Details -->
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-4">
                                                <select class="form-select" name="CourseChapters[@i].Resources[@j].ResourceType"
                                                    value="@resource.ResourceType" asp-items="ViewBag.ResourceTypes">
                                                </select>
                                            </div>

                                            <div class="col-md-5">
                                                <div class="input-group">
                                                    <input type="file" class="form-control" name="CourseChapters[@i].Resources[@j].File"
                                                        accept=".pdf,.doc,.docx,.ppt,.pptx,.mp4,.mp3">
                                                </div>
                                            </div>

                                            <div class="col-md-3">
                                                @if (!string.IsNullOrEmpty(resource.FileUrl))
                                                {
                                                    <a href="@resource.FileUrl" class="btn-green-outline btn-sm" target="_blank">
                                                        <i class="bi bi-file-earmark-arrow-down"></i> View Resource
                                                    </a>
                                                }
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Add Resource Button -->
                    <button type="button" class="btn btn-green-outline btn-sm mt-3" onclick="addResource(this)">
                        <i class="bi bi-plus-lg"></i> Add Resource
                    </button>
                </div>
            </div>
        </div>
    }
}