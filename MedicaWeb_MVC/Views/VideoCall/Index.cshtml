@using MedicaWeb_MVC.ViewModels.VideoCall
@model VideoCallVM
@{
    bool isVideoEnabled = true, isAudioEnabled = true, isSignalRConnected = true, isWebcamActive = false;
}

<script>
    // Initialize state object
    window.videoCallState = {
        isVideoEnabled: @Json.Serialize(isVideoEnabled),
        isAudioEnabled: @Json.Serialize(isAudioEnabled),
        isSignalRConnected: @Json.Serialize(isSignalRConnected),
        isWebcamActive: @Json.Serialize(isWebcamActive),
    };
</script>

<input type="hidden" id="userName" value="@Model.UserName" />
<input type="hidden" id="fullName" value="@Model.FullName" />
<input type="hidden" id="userRole" value="@Model.RoleName" />
<div class="video-meeting-container">
    <div class="main-video-section">
        <div class="video-item" id="localVideoContainer">
            <video id="lecturer-video" autoplay playsinline muted></video>
            <video hidden id="participant-video" autoplay playsinline muted></video>
            @if (Model.RoleName == "Lecturer")
            {
                <div class="participant-name" id="lecturer-name">You</div>
            }
            else
            {
                <div class="participant-name" id="lecturer-name">Lecturer</div>
            }
        </div>
    </div>

    <div class="participant-list">
        <div class="participant-header">
            <h3>Participants</h3>
        </div>
        <div class="participant-items" id="participantItems">
            <div class="participant-item active">
                <div class="participant-info">
                    <span class="name">@Model.FullName</span>
                    <span class="status">Speaking</span>
                </div>
            </div>
        </div>
    </div>
    
    @if (Model.RoleName == "Lecturer")
    {
        <div class="control-panel">
            <button class="control-btn" onclick="toggleAudio()" id="audioBtn">
                <i class="bi bi-mic-fill"></i>
        </button>
        <button class="control-btn" onclick="toggleVideo()" id="videoBtn">
            <i class="bi bi-camera-video-fill"></i>
        </button>
        <button class="control-btn leave-btn" onclick="leaveRoom()">
                <i class="bi bi-telephone-x-fill"></i>
            </button>
        </div>
    } else {
        <div class="control-panel">
        <button class="control-btn" onclick="toggleAudio()" id="audioBtn">
                <i class="bi bi-mic-fill"></i>
        </button>
        <button class="control-btn leave-btn" onclick="leaveRoom()">
                <i class="bi bi-telephone-x-fill"></i>
            </button>
        </div>
    }
</div>

@section Scripts {
    <script>
        const audioBtn = document.getElementById('audioBtn');
        const videoBtn = document.getElementById('videoBtn');
        const participantItems = document.getElementById('participantItems');
        let participantCount = 1; // Start with 1 (local user)

        @* function addParticipantVideo(connectionId, stream) {
            // Create participant list item
            const participantItem = document.createElement('div');
            participantItem.className = 'participant-item';
            participantItem.id = `participant-${connectionId}`;
            
            const participantInfo = document.createElement('div');
            participantInfo.className = 'participant-info';
            
            const nameSpan = document.createElement('span');
            nameSpan.className = 'name';
            nameSpan.textContent = `Participant ${connectionId}`;
            
            const statusSpan = document.createElement('span');
            statusSpan.className = 'status';
            statusSpan.textContent = 'Connected';
            
            participantInfo.appendChild(nameSpan);
            participantInfo.appendChild(statusSpan);
            participantItem.appendChild(participantInfo);
            participantItems.appendChild(participantItem);

            // Set up video stream
            if (stream) {
                const video = document.createElement('video');
                video.autoplay = true;
                video.playsInline = true;
                video.srcObject = stream;
                video.id = `video-${connectionId}`;
                video.style.display = 'none'; // Hide video element but keep it for audio
                document.body.appendChild(video);
            }

            participantCount++;
        }

        function removeParticipantVideo(connectionId) {
            // Remove from participant list
            const participantItem = document.getElementById(`participant-${connectionId}`);
            if (participantItem) {
                participantItem.remove();
            }

            // Remove hidden video element
            const video = document.getElementById(`video-${connectionId}`);
            if (video) {
                video.remove();
            }

            participantCount--;
        } *@

        @* Video element reference *@
        const remoteVideo = document.getElementById('remoteVideo');
        const connectionStatus = document.getElementById('connectionStatus');
        let isConnected = false;

        @* Update connection status *@
        function updateConnectionStatus(connected) {
            isConnected = connected;
            connectionStatus.textContent = isConnected ? "Remote User" : "Waiting for someone to join...";
        }
    </script>
    <script src="~/signalr/dist/browser/signalr.js"></script>
    <script type="module" src="~/js/video-call/video-call-service.js"></script>
    <script type="module" src="~/js/video-call/video-call.js"></script>
}
