<div class="container-fluid">
	<div class="row">
		<div class="page-title-box d-flex align-items-center justify-content-between">
			<h4 class="mb-0">Dashboard</h4>
		</div>
	</div>
	<div class="row">

		<!-- Total Feedbacks -->
		<div class="col-md-6 col-xl-4 mt-2">
			<div class="card shadow-lg">
				<div class="card-body">
					<div class="float-end mt-2">
						<div id="totalFeedbacksRadialChart"></div>
					</div>
					<div>
						<p class="text-muted mb-0">Total Feedbacks</p>
						<h4 class="my-1">
							<span id="spanTotalFeedbacksCount">XX</span>
						</h4>
					</div>
					<p class="text-muted mt-3 mb-0" id="sectionFeedbacksCurrentCount"></p>

					<div class="justify-content-center text-center chart-spinner" style="display:none">
						<div class="spinner-border" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
					</div>

				</div>
			</div>
		</div>

		<!-- Total Registered Users -->
		<div class="col-md-6 col-xl-4 mt-2">
			<div class="card shadow-lg">
				<div class="card-body">
					<div class="float-end mt-2">
						<div id="totalUsersRadialChart"></div>
					</div>
					<div>
						<p class="text-muted mb-0">Total Users</p>
						<h4 class="my-1">
							<span id="spanTotalUsersCount">XX</span>
						</h4>
					</div>
					<p class="text-muted mt-3 mb-0" id="sectionUsersCurrentCount"></p>

					<div class="justify-content-center text-center chart-spinner" style="display:none">
						<div class="spinner-border" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
					</div>

				</div>
			</div>
		</div>

		<!-- Total Courses -->
		<div class="col-md-6 col-xl-4 mt-2">
			<div class="card shadow-lg">
				<div class="card-body">
					<div class="float-end mt-2">
						<div id="totalCoursesRadialChart"></div>
					</div>
					<div>
						<p class="text-muted mb-0">Total Courses</p>
						<h4 class="my-1">
							<span id="spanTotalCoursesCount">XX</span>
						</h4>
					</div>
					<p class="text-muted mt-3 mb-0" id="sectionCoursesCurrentCount"></p>

					<div class="justify-content-center text-center chart-spinner" style="display:none">
						<div class="spinner-border" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
					</div>

				</div>
			</div>
		</div>

		<!-- Line Chart -->
		<div class="col-md-12 col-xl-8 mt-2">
			<div class="card shadow-lg">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center mb-3">
						<p class="text-muted mb-0">Order Growth Over Time</p>
						<div class="d-flex gap-2">
							<select class="form-select form-select-sm" id="dateRangeSelect" style="width: auto;">
								<option value="180">Last 6 Months</option>
								<option value="365">Last Year</option>
								<option value="730">Last 2 Years</option>
								<option value="custom">Custom Range</option>
							</select>
							<div id="customDateRange" class="d-none">
								<input type="date" class="form-control form-control-sm" id="startDate" style="width: auto;">
								<input type="date" class="form-control form-control-sm" id="endDate" style="width: auto;">
							</div>
						</div>
					</div>

					<div style="position: relative; height: 350px;">
						<canvas id="orderGrowthChart" style="width: 100%"></canvas>
					</div>

					<div class="justify-content-center text-center chart-spinner" style="display:none">
						<div class="spinner-border" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Pie Chart -->
		<div class="col-md-12 col-xl-4 mt-2">
			<div class="card shadow-lg">
				<div class="card-body">
					<div class="">
						<p class="text-muted mb-0">Orders Status</p>
					</div>

					<canvas id="ordersStatusPieChart"></canvas>

					<div>
						<h4 class="my-1">
							<span id="spanTotalOrdersCount">0</span> Total Orders
						</h4>
					</div>
					<p class="text-muted mt-3 mb-0" id="orderStatusSummary"></p>

					<div class="justify-content-center text-center chart-spinner" style="display:none">
						<div class="spinner-border" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
					</div>

				</div>
			</div>
		</div>


	</div>
</div>

@section Scripts {
	<script src="~/js/charts/loadRadialChart.js"></script>
	<script src="~/js/charts/getTotalFeedbacksRadialChart.js"
			asp-append-version="true"></script>
	<script src="~/js/charts/getTotalCoursesRadialChart.js"
			asp-append-version="true"></script>
	<script src="~/js/charts/getTotalUsersRadialChart.js"
			asp-append-version="true"></script>
	<script src="~/js/charts/getOrderGrowthLineChart.js"
			asp-append-version="true"></script>
	<script src="~/js/charts/getOrderStatusPieChart.js"
			asp-append-version="true"></script>

	<script>
		// Function to show/hide loading spinner
		function toggleSpinner(show) {
			document.querySelectorAll('.chart-spinner').forEach(spinner => {
				spinner.style.display = show ? 'block' : 'none';
			});
		}

		// Update both charts
		function updateCharts() {
			toggleSpinner(true);

			// Update Pie Chart
			fetch('/Dashboard/GetOrderStatusPieChartData')
				.then(response => response.json())
				.then(data => {
					window.updateOrderStatusPieChart(data);
				})
				.finally(() => toggleSpinner(false));

			// Update Line Chart
			window.updateOrderGrowthLineChart();
		}

		// Event Listeners
		document.addEventListener('DOMContentLoaded', function() {
			// Initialize date range controls
			window.initOrderGrowthDateRangeControls();

			// Initial load
			updateCharts();
		});

		// Refresh every 5 minutes
		setInterval(updateCharts, 300000);
	</script>
}