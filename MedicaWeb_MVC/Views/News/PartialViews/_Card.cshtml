@using MedicaWeb_MVC.ViewModels.News
@model NewsVM

<div class="news-card h-100" id="@Model.Id">
    <a asp-controller="News" asp-action="Details" asp-route-id="@Model.Id" class="news-card text-decoration-none">
        <div class="image-container bg-light" style="height: 200px; overflow: hidden; position: relative;">
            <img src="@Model.ImageUrl" alt="News Image" class="news-img" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;">
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title text-orange mb-0">@Model.Title</h5>
                <span class="badge @(Model.Status.ToString() == "Active" ? "active" : "inactive")">
                    @Model.Status
                </span>
            </div>

            <p class="news-info"><strong>Type:</strong> @Model.NewsType</p>
            <p class="news-info"><strong>Updated:</strong> @Model.UpdatedAt.ToString("dd/MM/yyyy")</p>

            <div class="d-flex justify-content-end align-items-center mt-2">
                <span class="text-green fw-semibold">Read More</span>
            </div>
        </div>
    </a>
</div> 