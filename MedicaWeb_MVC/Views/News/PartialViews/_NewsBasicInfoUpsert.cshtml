@using MedicaWeb_MVC.ViewModels.News
@model NewsUpsertVM


<div>
    <div class="form-group d-flex flex-column gap-3 mb-3 bg-light p-4 rounded-3" enctype="multipart/form-data">
        @* Title *@
        <div>
            <label asp-for="@Model.Title" class="form-label fw-semibold">
                <i class="bi bi-newspaper me-2"></i>Title
            </label>
            <input asp-for="@Model.Title" class="form-control" />
            <span asp-validation-for="@Model.Title" class="text-danger"></span>
        </div>

        @* Image *@
        <div class="row">
            <label asp-for="@Model.ImageUrl" class="form-label fw-semibold">
                <i class="bi bi-image me-2"></i>News Image
            </label>

            <div class="col-md-4">
                <img id="newsImagePreview" src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" 
                    style="width: 300px; height: 180px; object-fit: cover;" />
            </div>

            <div class="col-md-8">
                <input asp-for="@Model.ImageFile" class="form-control" type="file" onchange="previewImage(this)"/>
            </div>
            <span asp-validation-for="@Model.ImageUrl" class="text-danger"></span>
        </div>

        @* Content *@
        <div>       
            <label asp-for="@Model.Content" class="form-label fw-semibold">
                <i class="bi bi-journal-text me-2"></i>Content
            </label>
            <textarea id="newsContent-editor" asp-for="@Model.Content" class="form-control" rows="4"></textarea>
            <span asp-validation-for="@Model.Content" class="text-danger"></span>
        </div>

        @* News types *@
        <div>
                <label asp-for="@Model.NewsType" class="form-label fw-semibold">
                    <i class="bi bi-newspaper me-2"></i>News Type
                </label>
                <select asp-for="@Model.NewsType" class="form-control" asp-items="ViewBag.NewsTypes">
                    <option value="">Select News Type</option>
                </select>
                <span asp-validation-for="@Model.NewsType" class="text-danger"></span>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        const preview = document.getElementById('newsImagePreview');
        const file = input.files[0];
        const reader = new FileReader();

        reader.onload = function(e) {
            preview.src = e.target.result;
        };

        if (file) {
            reader.readAsDataURL(file);
        }
    }
</script>