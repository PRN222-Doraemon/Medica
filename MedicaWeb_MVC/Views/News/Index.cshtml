@using MedicaWeb_MVC.ViewModels.News
@using MedicaWeb_MVC.ViewModels.Shared

@model ListVM<NewsVM>

<div class="container py-4">
    <!-- Search and Filter Header -->
    <div class="row pb-4 header-container border-bottom border-secondary">
        <div class="col-md-6">
            @await Html.PartialAsync("~/Views/Shared/ReusableViews/_SearchBar.cshtml", Model.SearchValue)
        </div>
        <div class="col-md-6 d-flex justify-content-end gap-2">
            <form asp-controller="News" asp-action="Index" method="get" id="filterForm">
                <div class="d-flex gap-2">
                    <select class="form-select w-auto text-grey" name="NewsType" asp-items="ViewBag.NewsTypes"
                        onchange="submitForm()">
                        <option value="">All Types</option>
                    </select>
                    <select class="form-select w-auto text-grey" name="Status" asp-items="ViewBag.Status"
                        onchange="submitForm()">
                    </select>
                </div>
            </form>
            @if (User.IsInRole(AppCts.Roles.Employee))
            {
                <a class="btn btn-green d-flex align-items-center gap-2" asp-controller="News" asp-action="Upsert">
                    <i class="bi bi-plus-lg"></i>
                    Create new
                </a>
            }
        </div>
    </div>

    <div id="newsList" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 my-4">
        @foreach (var news in Model.Items)
        {
            <div class="col">
                <partial name="PartialViews/_Card" model="@news" />
            </div>
        }
    </div>

    <div>
        @await Html.PartialAsync("~/Views/Shared/ReusableViews/_Paging.cshtml", Model.PagingInfo)
    </div>
</div>


<script>
    function submitForm() {
        document.getElementById("filterForm").submit();
    }
</script>

<script src="~/lib/signalr/dist/browser/signalr.js"></script>
<script src="~/js/news/news-client.js"></script>
