@model MedicaWeb_MVC.ViewModels.News.NewsVM

<div class="container my-5">
    <div class="row mb-4">
        <div class="col-12">
            <div class="text-center mb-4">
                <span class="badge bg-warning text-dark px-3 py-2 mb-3">
                    <i class="fas fa-newspaper me-1"></i> 
                    @Model.NewsType
                </span>
                <h1 class="display-4 fw-bold">@Model.Title</h1>
                <p class="lead text-muted mt-3">@Model.Content.Substring(0, Math.Min(100, Model.Content.Length))@(Model.Content.Length > 100 ? "..." : "")</p>
                <div class="d-flex justify-content-center align-items-center mt-3">
                    <small class="text-muted me-3">
                        <i class="fas fa-calendar-alt me-1"></i> @Model.CreatedAt.ToString("MMMM dd, yyyy")
                    </small>
                    <small class="text-muted">
                        <i class="fas fa-sync-alt me-1"></i> Last Updated: @Model.UpdatedAt.ToString("MMMM dd, yyyy")
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden mb-4">
                <div class="card-header bg-dark text-white py-3 position-relative">
                    <span class="position-absolute top-0 start-0 bg-warning h-100" style="width: 5px;"></span>
                    <h4 class="mb-0 ms-3"><i class="fas fa-align-left me-2"></i>Article Content</h4>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="article-image mb-4" style="height: 400px; width: 100%; overflow: hidden;">
                            <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded shadow-sm w-100 h-100" style="object-fit: cover; object-position: center;">
                        </div>
                    }
                    <div class="article-content">
                        <p class="article-text">@Html.Raw(Model.Content)</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden mb-4">
                <div class="card-header bg-dark text-white py-3 position-relative">
                    <span class="position-absolute top-0 start-0 bg-warning h-100" style="width: 5px;"></span>
                    <h4 class="mb-0 ms-3"><i class="fas fa-info-circle me-2"></i>Article Details</h4>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <p class="text-muted mb-1">Status</p>
                        <span class="badge @(Model.Status == NewsStatus.Active ? "bg-success" : "bg-secondary") px-3 py-2 rounded-pill">
                            <i class="fas @(Model.Status == NewsStatus.Active ? "fa-check-circle" : "fa-times-circle") me-1"></i>
                            @Model.Status
                        </span>
                    </div>
                    
                    <div class="mb-4">
                        <p class="text-muted mb-1">Category</p>
                        <div>
                            <span class="badge bg-light text-dark px-3 py-2 border">
                                <i class="fas fa-folder me-1"></i> @Model.NewsType
                            </span>
                        </div>
                    </div>
                    
                    <hr class="my-4">
                    
                    <div class="row">
                        <div class="col-6 mb-3">
                            <p class="text-muted mb-1">Created</p>
                            <p class="mb-0">@Model.CreatedAt.ToString("MMM dd, yyyy")</p>
                        </div>
                        <div class="col-6 mb-3">
                            <p class="text-muted mb-1">Last Modified</p>
                            <p class="mb-0">@Model.UpdatedAt.ToString("MMM dd, yyyy")</p>
                        </div>
                    </div>
                    
                    <div class="mt-4">
                        <p class="text-muted mb-1">Article ID</p>
                        <span class="badge bg-dark px-3 py-2 rounded-pill">
                            <i class="fas fa-fingerprint me-1"></i> @Model.Id
                        </span>
                    </div>
                </div>
                <div class="card-footer bg-light py-3">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="fas fa-arrow-left me-2"></i> Back to List
                        </a>
                        @if (User.IsInRole(AppCts.Roles.Employee))
                        {
                            if (Model.Status == NewsStatus.Active)
                            {
                                <a asp-action="Delete" onclick="return confirmDisable()" asp-route-id="@Model.Id" class="btn btn-danger px-4 py-2 fw-bold">
                                    <i class="bi bi-x-circle-fill"></i> Disable Article 
                                </a>
                            }
                            else
                            {
                                <a asp-action="Enable" asp-route-id="@Model.Id" class="btn btn-success px-4 py-2 fw-bold">
                                    <i class="bi bi-check-circle-fill"></i> Enable Article
                                </a>
                            }

                            <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-dark position-relative overflow-hidden px-4 py-2 fw-bold">
                                <span class="position-relative z-1"><i class="bi bi-pencil"></i> Edit Article</span>
                                <span class="position-absolute top-0 start-0 bg-warning" style="height: 100%; width: 5px;"></span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
@section Scripts {
    <script>
        function confirmDisable() {
            return confirm("Are you sure you want to disable this article?");
        }
    </script>
}
