@using System.Security.Claims
@{
	var userName = User.Identity.IsAuthenticated ? User.FindFirst(ClaimTypes.Name)?.Value : "Guest";
	var role = User.Identity.IsAuthenticated ? User.FindFirst(ClaimTypes.Role)?.Value : "Guest";
}
@functions {
	string IsActive(string controller)
	{
		return Url.ActionContext.RouteData.Values["controller"]?.ToString() == controller ? "active text-white" : "";
	}
}
<!-- Sidebar -->
<div id="sidebar" class="d-flex flex-column flex-shrink-0 p-3 shadow position-fixed"
	style="background-color: #ffffff; width: 280px; height: 100vh; overflow-y: auto; top: 0; left: 0; z-index: 1000;">
	<a href="/" class="d-flex align-items-center mb-2 mt-2 mx-2 text-decoration-none">
		<i class="bi bi-heart-pulse me-2 fs-3" style="color: #FF7722;"></i>
		<span class="fs-4 fw-bold" style="color: #706d6d;">Medica</span>
	</a>
	<hr style="color: #4d4747;">

	<ul class="nav nav-pills flex-column mb-auto gap-2">
		<li class="nav-item">
			<a asp-controller="News" asp-action="Index"
				class="nav-link d-flex align-items-center p-3 rounded-3 @IsActive("Dashboard")"
				style=" color: #555555;">
				<i class="bi bi-card-list me-3 fs-5 @IsActive("Dashboard")" style="color: #FF9955;"></i>
				<span>News</span>
			</a>
		</li>
		<li>
			<a asp-controller="Courses" asp-action="Index"
				class="nav-link d-flex align-items-center p-3 rounded-3 @IsActive("Courses")" style="color: #555555;">
				<i class="bi bi-book-half me-3 fs-5 @IsActive("Courses")" style="color: #FF9955;"></i>
				<span>Courses</span>
			</a>
		</li>
		@if (User.IsInRole(AppCts.Roles.Lecturer))
		{
			<li>
				<a asp-controller="Classrooms" asp-action="MyClass"
					class="nav-link d-flex align-items-center p-3 rounded-3 @IsActive("Classrooms")"
					style="color: #555555;">
					<i class="bi bi-people-fill me-3 fs-5 @IsActive("Classrooms")" style="color: #FF9955;"></i>
					<span>My Classes</span>
				</a>
			</li>
		}
	</ul>

	<hr style="color: #585454; margin-top: 2rem;">
	<div class="user-menu mt-3 mb-3 ps-3 pe-4 py-2 rounded bg-white">
		<ul class="nav flex-column">
			<li class="nav-item mb-2">
				<a asp-controller="Accounts" asp-action="Profile"
				   class="nav-link d-flex align-items-center p-2 rounded-3 text-decoration-none user-profile">
					<i class="bi bi-person-circle me-2"></i>
					<span>View Profile</span>
				</a>
			</li>
			<li class="nav-item">
				<a asp-action="Logout" asp-controller="Accounts"
					class="nav-link py-2 px-3 d-flex align-items-center rounded-3 user-menu-item text-muted">
					<i class="bi bi-box-arrow-right me-2"></i> Sign out
				</a>
			</li>
		</ul>
	</div>
</div>

<style>
	.nav-link:hover {
		background-color: #FFF2E9;
		box-shadow: 0 0.25rem 0.5rem rgba(255, 119, 34, 0.15);
		transition: all 0.3s ease;
	}

	.nav-link.active {
		font-weight: 600;
		background-color: var(--primary-color) !important;
		box-shadow: 0 0.25rem 0.75rem rgba(255, 119, 34, 0.25);
	}

	.nav-link {
		transition: all 0.3s ease;
		margin-bottom: 5px;
	}

	.dropdown-toggle:hover {
		background-color: #FFF2E9;
		transition: all 0.3s ease;
	}
</style>
