@model dynamic

@{
	// Get the Generic Controller passed in
	var controller = Model.Controller as string;
}

<div class="card shadow-lg">
	<div class="card-body">
		<!-- Table -->
		<div class="table-responsive">
			<table class="table table-hover align-middle" id="dataTable">
				<thead class="table-light">
					<tr>
						@foreach (var column in Model.Columns)
						{
							<th class="text-nowrap">@column.Value</th>
						}
						@if (!controller.Equals("OrdersManagement"))
						{
							<th class="text-nowrap">Actions</th>
						}
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.Items)
					{
						<tr>
							@foreach (var column in Model.Columns)
							{
								<td>
									@if (column.Key == "IsActive" || column.Key == "Status")
									{
										var status = item[column.Key];
										string badgeClass = "secondary";
										string statusText = status.ToString();

										if (controller.Equals("AccountsManagement"))
										{
											var isEnabled = status is bool ? (bool)status : status.ToString() == "Enabled";
											badgeClass = isEnabled ? "success" : "danger";
										}
										else if (controller.Equals("OrdersManagement"))
										{
											switch (status.ToString())
											{
												case "Pending":
													badgeClass = "warning";
													break;
												case "Paid":
													badgeClass = "success";
													break;
												case "Failed":
													badgeClass = "danger";
													break;
												case "Refunded":
													badgeClass = "info";
													break;
												default:
													badgeClass = "secondary";
													break;
											}
										}

										<span class="badge bg-@badgeClass">
											@statusText
										</span>
									}
									else
									{
										@item[column.Key]
									}
								</td>
							}
							@if (!controller.Equals("OrdersManagement"))
							{
								<td>
									<div class="btn-group">
										<a href="@Url.Action("Edit", controller, new { id = item["Id"] })" class="btn btn-warning">
											Edit <i class="fas fa-edit"></i>
										</a>
										<form asp-action="Delete" asp-controller="@controller" method="get">
											<input name="Id" value='@item["Id"]' hidden />
											<button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this item?');">
												Delete <i class="fas fa-trash"></i>
											</button>
										</form>
									</div>
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		$(document).ready(function () {
			// Initialize DataTable
			$('#dataTable').DataTable({
				"pageLength": 10,
				"ordering": true,
				"responsive": true,
				"language": {
					"search": "Search:",
					"lengthMenu": "Show _MENU_ entries per page",
					"info": "Showing _START_ to _END_ of _TOTAL_ entries",
					"infoEmpty": "Showing 0 to 0 of 0 entries",
					"infoFiltered": "(filtered from _MAX_ total entries)",
					"zeroRecords": "No matching records found",
					"paginate": {
						"first": "First",
						"last": "Last",
						"next": "Next",
						"previous": "Previous"
					}
				}
			});
		});
	</script>
}
