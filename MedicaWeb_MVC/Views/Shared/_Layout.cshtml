@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">

@* Head & Metadata *@

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - MedicaWeb_MVC</title>

	@* CSSs *@
	<link rel="stylesheet" href="~/lib/bootswatch/litera/bootstrap.min.css" />
	<link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/lib/toastr.js/toastr.min.css" />
	<link rel="stylesheet" href="~/lib/datatables.net-bs5/datatables.bootstrap5.min.css" />
	<link rel="stylesheet" href="~/MedicaWeb_MVC.styles.css" asp-append-version="true" />
	<link rel="stylesheet"
		  href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;700&display=swap" />

	@* Load SignalR and chat.js in head to ensure functions are available *@
	<script src="~/js/chat.js"></script>

	@if (User.Identity.IsAuthenticated && User.IsInRole(AppCts.Roles.Student))
	{
		<script>
			// Initialize chat immediately
			window.addEventListener('load', function() {
				initializeChat(@User.FindFirst(ClaimTypes.NameIdentifier)?.Value);
			});
		</script>
	}

</head>

@* Body *@

<body class="d-flex flex-column min-vh-100">

	@* Header *@
	<header>
		<partial name="ReusableViews/_NavBar" />
	</header>

	@* Container *@
	<div class="container">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	@if (User.Identity.IsAuthenticated && User.IsInRole(AppCts.Roles.Student))
	{
		@await Html.PartialAsync("_ChatPopup", int.Parse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value))
	}

	@* jQuery and Libraries - Load them at the bottom to optimize performance *@
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/lib/toastr.js/toastr.min.js"></script>
	<script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>
	<script src="~/lib/datatables.net/datatables.min.js"></script>
	<script src="~/lib/datatables.net-bs5/datatables.bootstrap5.min.js" asp-append-version="true"></script>
	<script src="~/lib/signalr/dist/browser/signalr.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>

	@* Applied All Page Partial Views *@
	<partial name="ReusableViews/_Notification" />
	<partial name="ReusableViews/_Footer" />

	@await RenderSectionAsync("Scripts", required: false)

</body>

</html>
